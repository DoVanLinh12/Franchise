APP_NAME=Franchise Management API
ENVIRONMENT=development
APP_DEBUG=true
DATABASE_URL=postgresql://franchise:franchise@localhost:5432/franchise
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret-for-your-local-project
JWT_ALGORITHM=HS256
JWT_ISSUER=franchise-api
JWT_AUDIENCE=franchise-api-users
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=noreply@franchise.local
