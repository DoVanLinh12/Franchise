  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8000"},
    {"key": "accessToken", "value": ""},
    {"key": "ownerToken", "value": ""},
    {"key": "accountantToken", "value": ""},
    {"key": "ownerId", "value": ""},
    {"key": "runId", "value": ""},
    {"key": "today", "value": ""},
    {"key": "monthStart", "value": ""},
    {"key": "nextWeek", "value": ""},
    {"key": "nextYear", "value": ""}
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {"exec": [
        "if (!pm.collectionVariables.get('runId')) {",
        "  const now = new Date();",
        "  const iso = d => d.toISOString().slice(0, 10);",
        "  const nextWeek = new Date(now); nextWeek.setUTCDate(nextWeek.getUTCDate() + 7);",
        "  const nextYear = new Date(now); nextYear.setUTCFullYear(nextYear.getUTCFullYear() + 1);",
        "  pm.collectionVariables.set('runId', String(Date.now()));",
        "  pm.collectionVariables.set('today', iso(now));",
        "  pm.collectionVariables.set('monthStart', `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, '0')}-01`);",
        "  pm.collectionVariables.set('nextWeek', iso(nextWeek));",
        "  pm.collectionVariables.set('nextYear', iso(nextYear));",
        "}"
      ]}
    }
  ]
}
