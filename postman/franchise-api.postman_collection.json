    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login seeded admin",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\":\"admin@franchise.local\",\"password\":\"Admin@123\"}"},
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('login 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.expect(body.access_token).to.be.a('string');",
            "pm.collectionVariables.set('accessToken', body.access_token);"
          ]}}]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
